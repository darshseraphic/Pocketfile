{
  "manifest_version": 3,
  "name": "PocketFiles \u2014 Local File Hub",
  "short_name": "PocketFiles",
  "version": "0.4.2",
  "description": "Search, browse, preview, drag, copy and ZIP files from folders you choose.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open PocketFiles",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
